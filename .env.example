# MongoDB Database URI (LMS Database)
MONGODB_LMS_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<app-name>"

# Optional collection-name overrides for staged database renames.
# Leave unset until the MongoDB collections have been migrated.
# MONGODB_TEAM_ACCOUNT_COLLECTION="team_accounts"
# MONGODB_VOLUNTEER_COLLECTION="volunteers"

# UploadThing Config
UPLOADTHING_TOKEN="your_uploadthing_api_token_here"

# NextAuth Config (if applicable/legacy)
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000/"


# Secret for LMS internal communication (Volunteers/Admins)
INTERNAL_JWT_SECRET="your_internal_jwt_secret_here"

# Resend Mailer API Key
RESEND_API_KEY="re_your_resend_api_key_here"
