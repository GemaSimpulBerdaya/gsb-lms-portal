# Auto-detect text files and normalize line endings to LF in the repo.
# Working tree on Windows can keep CRLF, but the index always stores LF.
* text=auto eol=lf

# Force LF for source / config / docs (cross-platform safety)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Binary files — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.zip binary
*.swp binary
